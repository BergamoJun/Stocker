          "enum": [
            "interest_rates",
            "energy_prices",
            "energy_supply",
            "energy_demand",
            "economic_growth",
            "company_revenue",
            "equity_prices",
            "unknown",
            "prices"
          ]
        },
        "economic_variable": {
          "enum": [
            "interest_rate",
            "energy_price",
            "production_volume",
            "consumption_volume",
            "economic_growth",
            "revenue",
            "stock_price",
            "unknown",
            "price"
          ]
        },
        "event_type": {
          "enum": [
            "financing_policy",
            "commodity_price",
            "energy_supply",
            "energy_demand",
            "economic_growth",
            "company_financial",
            "equity_price",
            "unknown",
            "price_change"
          ]
        },
        "variable_direction": {
          "enum": [
            "increase",
            "decrease",
            "unchanged",
            "non_increase",
            "non_decrease",
            "mixed",
            "unknown"
          ]
        },
        "statement_type": {
          "enum": [
            "current_action",
            "historical_observation",
            "forward_outlook",
            "unknown"
          ]
        },
        "negation": {
          "enum": [
            "none",
            "negated",
            "double_negation",
            "ambiguous"
          ]
        },
        "modality": {
          "enum": [
            "actual",
            "expected",
            "possible",
            "unknown"
          ]
        },
        "conditionality": {
          "enum": [
            "unconditional",
            "conditional",
            "unknown"
          ]
        },
        "condition_quote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600
        },
        "temporal_reference": {
          "enum": [
            "present",
            "past",
            "future",
            "mixed",
            "unknown"
          ]
        },
        "horizon": {
          "enum": [
            "within_five_sessions",
            "longer_term",
            "unknown"
          ]
        },
        "proposition_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "paragraph_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "span_start": {
          "type": "integer",
          "minimum": 0
        },
        "span_end": {
          "type": "integer",
          "minimum": 1
        },
        "sentence_quote": {
          "type": "string",
          "maxLength": 5000
        },
        "context_subject": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 600
        },
        "condition_verification": {
          "enum": [
            "NOT_ESTABLISHED",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_status": {
          "enum": [
            "SEMANTICALLY_SUPPORTED",
            "AMBIGUOUS",
            "CONTRADICTED",
            "UNSUPPORTED"
          ]
        },
        "ambiguity_reason": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "temporal_expression": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "source_published_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      },
      "required": [
        "exact_quote",
        "economic_subject",
        "economic_variable",
        "event_type",
        "variable_direction",
        "statement_type",
        "negation",
        "modality",
        "conditionality",
        "condition_quote",
        "temporal_reference",
        "horizon",
        "proposition_id",
        "source_id",
        "paragraph_id",
        "span_start",
        "span_end",
        "sentence_quote",
        "context_subject",
        "condition_verification",
        "evidence_status",
        "ambiguity_reason",
        "temporal_expression",
        "source_published_date"
      ],
      "additionalProperties": false
    },
    "researcher_raw": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "PROPOSE",
            "ABSTAIN",
            "UNKNOWN"
          ]
        },
        "selected_route_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "maxItems": 7,
          "uniqueItems": true
        },
        "unresolved_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "maxItems": 32,
          "uniqueItems": true
        }
      },
      "required": [
        "decision",
        "selected_route_ids",
        "unresolved_conditions"
      ],
      "additionalProperties": false
    },
    "critic_raw": {
      "type": "object",
      "properties": {
        "verdict": {
          "enum": [
            "SUPPORTED_CONDITIONAL",
            "UNSUPPORTED",
            "CONTRADICTED",
            "AMBIGUOUS",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "counter_evidence_status": {
          "enum": [
            "FOUND",
            "NOT_FOUND_OR_UNAVAILABLE"
          ]
        },
        "counter_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "proposition_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "paragraph_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "exact_quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            },
            "required": [
              "proposition_id",
              "source_id",
              "paragraph_id",
              "exact_quote"
            ],
            "additionalProperties": false
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "cautions": {
          "type": "array",
          "items": {
            "enum": [
              "exposure_missing",
              "contract_or_hedge_unknown",
              "competing_mechanisms",
              "expectations_unmeasured",
              "stock_horizon_unverified",
              "semantic_ambiguity"
            ]
          },
          "maxItems": 6,
          "uniqueItems": true
        }
      },
      "required": [
        "verdict",
        "counter_evidence_status",
        "counter_evidence",
        "cautions"
      ],
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "contract": {
          "const": "issuer-research-report-v3"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "identity": {
          "type": "object",
          "properties": {
            "cik": {
              "type": "string",
              "pattern": "^[0-9]{10}$"
