{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "semantic_raw": {
      "type": "object",
      "properties": {
        "propositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "exact_quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "economic_subject": {
                "enum": [
                  "interest_rates",
                  "energy_prices",
                  "energy_supply",
                  "energy_demand",
                  "economic_growth",
                  "company_revenue",
                  "equity_prices",
                  "unknown",
                  "prices"
                ]
              },
              "economic_variable": {
                "enum": [
                  "interest_rate",
                  "energy_price",
                  "production_volume",
                  "consumption_volume",
                  "economic_growth",
                  "revenue",
                  "stock_price",
                  "unknown",
                  "price"
                ]
              },
              "event_type": {
                "enum": [
                  "financing_policy",
                  "commodity_price",
                  "energy_supply",
                  "energy_demand",
                  "economic_growth",
                  "company_financial",
                  "equity_price",
                  "unknown",
                  "price_change"
                ]
              },
              "variable_direction": {
                "enum": [
                  "increase",
                  "decrease",
                  "unchanged",
                  "non_increase",
                  "non_decrease",
                  "mixed",
                  "unknown"
                ]
              },
              "statement_type": {
                "enum": [
                  "current_action",
                  "historical_observation",
                  "forward_outlook",
                  "unknown"
                ]
              },
              "negation": {
                "enum": [
                  "none",
                  "negated",
                  "double_negation",
                  "ambiguous"
                ]
              },
              "modality": {
                "enum": [
                  "actual",
                  "expected",
                  "possible",
                  "unknown"
                ]
              },
              "conditionality": {
                "enum": [
                  "unconditional",
                  "conditional",
                  "unknown"
                ]
              },
              "condition_quote": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 600
              },
              "temporal_reference": {
                "enum": [
                  "present",
                  "past",
                  "future",
                  "mixed",
                  "unknown"
                ]
              },
              "horizon": {
                "enum": [
                  "within_five_sessions",
                  "longer_term",
                  "unknown"
                ]
              },
              "temporal_expression": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              }
            },
            "required": [
              "exact_quote",
              "economic_subject",
              "economic_variable",
              "event_type",
              "variable_direction",
              "statement_type",
              "negation",
              "modality",
              "conditionality",
              "condition_quote",
              "temporal_reference",
              "horizon",
              "temporal_expression"
            ],
            "additionalProperties": false
          },
          "maxItems": 8,
          "uniqueItems": true
        }
      },
      "required": [
        "propositions"
      ],
      "additionalProperties": false
    },
    "proposition": {
