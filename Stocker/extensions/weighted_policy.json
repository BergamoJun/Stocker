    "trend_distance": {"group": "price_setup", "weight": "4", "label": "20일 평균 대비 추세", "formula": "clip((close - SMA20) / ATR14, -1, 1)", "range": ["-1", "1"]},
    "trend_structure": {"group": "price_setup", "weight": "3", "label": "20·60일 평균의 배열", "formula": "clip((SMA20 - SMA60) / ATR14, -1, 1)", "range": ["-1", "1"]},
    "momentum_five": {"group": "price_setup", "weight": "4", "label": "변동폭 대비 5일 가격 변화", "formula": "clip(return5_pct / (ATR14/close*100*sqrt(5)), -1, 1)", "range": ["-1", "1"]},
    "volume_confirmation": {"group": "price_setup", "weight": "2", "label": "상승·하락 방향의 거래량 확인", "formula": "sign(close - previous_close) * clip(volume/prior20mean - 1, 0, 1)", "range": ["-1", "1"]},
    "overextension": {"group": "price_setup", "weight": "2", "label": "단기 급등 이격 감점", "formula": "-clip(((close-SMA20)/ATR14 - 2)/2, 0, 1)", "range": ["-1", "0"]},
    "operating_margin": {"group": "fundamentals", "weight": "3", "label": "영업 수익성", "formula": "clip(same_period_consolidated_operating_income/revenue*100/20, -1, 1)", "range": ["-1", "1"]},
