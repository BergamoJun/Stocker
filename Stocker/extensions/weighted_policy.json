    "relative_market": {"group": "market_sector", "weight": "2", "label": "시장 대비 5일 상대 변화", "formula": "clip(aligned_stock_minus_market_return5_pp / 5, -1, 1)", "range": ["-1", "1"]},
    "relative_sector": {"group": "market_sector", "weight": "2", "label": "업종 대비 5일 상대 변화", "formula": "clip(aligned_stock_minus_sector_return5_pp / 5, -1, 1)", "range": ["-1", "1"]},
