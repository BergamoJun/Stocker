    "cash_coverage": {"group": "fundamentals", "weight": "2", "label": "총부채 대비 현금 여력", "formula": "clip((same_date_cash/liabilities - 0.1)/0.2, -1, 1); not current ratio", "range": ["-1", "1"]},
