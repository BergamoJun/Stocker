{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["contract","run_id","generated_at","input_folder","input_sha256","baseline_path","baseline_sha256","method_hashes","identity","is_illustrative","evidence_as_of","source_ids","features","benchmarks","measure_limitations","released_score","released_price_plan","source_requests","external_inference_calls","model_training_performed","record_sha256"],
  "properties":{
    "contract":{"const":"turnover-proxy-research-v1"},"run_id":{"type":"string","pattern":"^[a-f0-9]{32}$"},"generated_at":{"type":"string"},
    "input_folder":{"type":"string"},"input_sha256":{"$ref":"#/$defs/hash"},"baseline_path":{"type":"string"},"baseline_sha256":{"$ref":"#/$defs/hash"},
    "method_hashes":{"type":"object","additionalProperties":{"$ref":"#/$defs/hash"}},"identity":{"type":"object"},"is_illustrative":{"type":"boolean"},"evidence_as_of":{"type":"string"},
    "source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
    "features":{"type":"object","additionalProperties":false,"required":["reference_session","status","reason_code","measure","relative_notional","persistence_3","persistence_5","close_location","return_5_pct","extension_atr","signals","flags","news_alignment","institutional_activity_verified","released_score"],
      "properties":{"reference_session":{"type":["string","null"]},"status":{"enum":["available","partial","unavailable"]},"reason_code":{"type":["string","null"]},"measure":{"const":"close_times_reported_volume_proxy"},
        "relative_notional":{"$ref":"#/$defs/number"},"persistence_3":{"$ref":"#/$defs/number"},"persistence_5":{"$ref":"#/$defs/number"},"close_location":{"$ref":"#/$defs/number"},"return_5_pct":{"$ref":"#/$defs/number"},"extension_atr":{"$ref":"#/$defs/number"},
        "signals":{"type":"object","additionalProperties":false,"required":["original_volume","relative_notional","persistent_notional"],"properties":{"original_volume":{"$ref":"#/$defs/number"},"relative_notional":{"$ref":"#/$defs/number"},"persistent_notional":{"$ref":"#/$defs/number"}}},
        "flags":{"type":"array","uniqueItems":true,"items":{"enum":["RELATIVE_ACTIVITY_EXPANDED","PRICE_EXTENSION_NOT_PROOF_OF_PRICING_IN","HIGH_ACTIVITY_WITH_LOWER_RANGE_CLOSE"]}},
        "news_alignment":{"const":{"status":"withheld","reason":"NO_VERIFIED_EVENT_TIMESTAMP"}},"institutional_activity_verified":{"const":false},"released_score":{"type":"null"}}},
    "benchmarks":{"type":"object"},"measure_limitations":{"type":"array","items":{"type":"string"}},"released_score":{"type":"null"},"released_price_plan":{"type":"null"},"source_requests":{"const":0},"external_inference_calls":{"const":0},"model_training_performed":{"const":false},"record_sha256":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"number":{"type":["string","null"],"pattern":"^-?[0-9]+(\\.[0-9]+)?$"}}
}
