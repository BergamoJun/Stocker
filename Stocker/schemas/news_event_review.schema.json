{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["version", "policy_id", "news_context_sha256", "template_only", "reviewer_id", "submitted_at", "events"],
  "properties": {
    "version": {"const": "1.0.0"}, "policy_id": {"const": "news-original-evidence-review-v1"},
    "news_context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "template_only": {"type": "boolean"},
    "reviewer_id": {"type": ["string", "null"], "minLength": 1}, "submitted_at": {"type": ["string", "null"], "format": "date-time"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "review_status", "review_id", "source_ids", "original_urls", "rationale", "five_session_relevance_explanation", "reviewed_at", "original_checks"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1}, "review_status": {"enum": ["reviewed", "irrelevant_reviewed"]}, "review_id": {"type": "string", "minLength": 1},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "original_urls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "rationale": {"type": "string", "minLength": 1}, "five_session_relevance_explanation": {"type": "string", "minLength": 1},
        "counterargument": {"type": "string", "minLength": 1}, "monitoring_event": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"}, "published_at": {"type": "string", "format": "date-time"}, "first_public_at": {"type": "string", "format": "date-time"},
        "direction": {"type": "integer", "enum": [-1, 0, 1]}, "impact": {"enum": ["low", "medium", "high"]}, "relevance": {"enum": ["direct_company", "sector", "macro"]},
        "reliability": {"enum": ["primary", "independently_confirmed", "reputable_single", "unverified"]}, "novelty": {"enum": ["new", "material_update", "recycled"]},
        "material_update_at": {"type": ["string", "null"], "format": "date-time"}, "material_change_reviewed": {"type": "boolean"},
        "original_checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["source_id", "url", "checked_at", "publication_verified", "published_at"], "properties": {
            "source_id": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "checked_at": {"type": "string", "format": "date-time"},
            "publication_verified": {"type": "boolean"}, "published_at": {"type": ["string", "null"], "format": "date-time"}}}}
      },
      "allOf": [{"if": {"properties": {"review_status": {"const": "reviewed"}}}, "then": {"required": ["published_at", "first_public_at", "direction", "impact", "relevance", "reliability", "novelty", "counterargument", "monitoring_event"]}}]
    }
  }
}
