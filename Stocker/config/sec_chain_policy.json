{
  "id": "reviewed-quarter-and-ttm-chain-v1",
  "version": "1.0.0",
  "monthly_data_budget_usd": 0,
  "maximum_document_requests_per_issuer": 4,
  "maximum_issuer_seconds": 120,
  "external_llm_calls": 0,
  "model_training_enabled": false,
  "release_enabled": false,
  "score_enabled": false,
  "metrics": ["revenue", "operating_income", "net_income", "operating_cash_flow", "capital_expenditure"],
  "additive_only": true,
  "eps_subtraction_or_sum": false,
  "balance_ttm": false,
  "cross_cik_merge": false,
  "amendment_policy": "explicit_review_and_exact_selected_component_reconciliation_only",
  "current_mode": "latest_interim_after_annual",
  "quarter_days": [60, 120],
  "annual_days": [330, 400],
  "maximum_quarter_length_difference_days": 7,
  "income_overlap_reconciliation": "exact_equality_or_withhold_qoq",
  "ttm_formula": "annual+current_ytd-prior_year_ytd",
  "availability": "new_packet_and_review_first_commits_strictly_before_cutoff_second",
  "historical_original_vintage_verified": false
}
