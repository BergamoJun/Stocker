{
  "id": "issuer-news-refresh-and-report-v1",
  "version": "1.0.0",
  "monthly_data_budget_usd": 0,
  "release_enabled": false,
  "external_llm_calls": 0,
  "model_training_enabled": false,
  "publisher_body_fetch_enabled": false,
  "numeric_news_score_enabled": false,
  "recommendation_score_enabled": false,
  "poll_interval_seconds": 900,
  "maximum_massive_requests": 3,
  "maximum_gdelt_requests": 5,
  "maximum_articles_per_query": 25,
  "lookback_hours": 72,
  "metadata_freshness_seconds": 1800,
  "maximum_review_reuse_hours": 24,
  "maximum_event_age_hours": 168,
  "global_queries": {"macro_politics": "(\"Federal Reserve\" OR \"energy policy\" OR sanctions OR tariffs)", "commodities": "(\"natural gas\" OR \"oil price\" OR \"copper price\")"},
  "gdelt_stop_after_first_failure": true,
  "massive_budget": "share_historical_panel_api_request_lock_budget_and_429_cooldown",
  "gdelt_budget": "reuse_existing_gdelt_shared_transport_and_cooldown",
  "official_feeds_clear_broad_topic_coverage": false,
  "cache_reuse": "preserve_original_observation_time_including_failures",
  "availability": "first_commit_and_full_equal_second_exclusion",
  "review_scope": "explicit_issuer_and_profile_binding; no_legacy_BE_review_rebinding",
  "source_text_policy": "titles_dates_links_only; discard_bodies_summaries_images_vendor_sentiment",
  "legacy_report_policy": "new_wrapper_contract_and_new_reports; preserve_all_old_methods_and_results"
}
